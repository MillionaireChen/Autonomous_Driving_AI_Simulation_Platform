# Copy to .env and adjust for your machine:  cp .env.example .env

# --- CARLA server package -----------------------------------------------
# Installed OUTSIDE the repo: the package is ~18 GB and must not enter git.
# This box keeps it on NFS /home because local disk has under 15 GB free.
CARLA_VERSION=0.9.16
CARLA_ROOT=/home/23R9802_Chen/carla/CARLA_0.9.16

# --- Client connection --------------------------------------------------
CARLA_HOST=127.0.0.1
CARLA_RPC_PORT=2000

# --- GPU isolation (spec section 4) -------------------------------------
# Pin CARLA rendering to one card. Never let it see all four.
CARLA_GPU=0

# --- Python environment -------------------------------------------------
# uv writes the venv here instead of ./.venv: local disk is far faster than
# NFS for imports, and the repo stays clean.
UV_PROJECT_ENVIRONMENT=/var/tmp/fls/adarena/venv
